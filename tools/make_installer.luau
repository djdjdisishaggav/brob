-- Generates command-bar installer scripts for people (or agents driving Roblox
-- Studio through MCP) who are not using the Rojo plugin. Each chunk recreates
-- part of the three MushroomLobby folders with the current sources.
-- Usage: lune run tools/make_installer   ->  build/install/NN_install.luau
local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local PLACE = "build/lobby.rbxl"
local OUT = "build/install"
local CHUNK_BYTES = 60000

local build = process.exec("rojo", { "build", "default.project.json", "-o", PLACE })
assert(build.ok, "rojo build failed:\n" .. build.stderr)
local game = roblox.deserializePlace(fs.readFile(PLACE))

local ROOTS = {
	{ service = "ReplicatedStorage", path = { "ReplicatedStorage" } },
	{ service = "ServerScriptService", path = { "ServerScriptService" } },
	{ service = "StarterPlayer", path = { "StarterPlayer", "StarterPlayerScripts" } },
}

-- Long-bracket literal that cannot be closed early by the source itself.
local function literal(source)
	local level = 1
	while source:find("]" .. string.rep("=", level) .. "]", 1, true) do
		level += 1
	end
	local eq = string.rep("=", level)
	return `[{eq}[\n{source}]{eq}]`
end

local entries = {}
local function walk(instance, path)
	local here = table.clone(path)
	table.insert(here, instance.Name)
	local isScript = instance.ClassName == "ModuleScript"
		or instance.ClassName == "Script"
		or instance.ClassName == "LocalScript"
	table.insert(entries, {
		path = here,
		className = instance.ClassName,
		source = if isScript then instance.Source else nil,
	})
	local children = instance:GetChildren()
	table.sort(children, function(a, b)
		return a.Name < b.Name
	end)
	for _, child in children do
		walk(child, here)
	end
end

for _, root in ROOTS do
	local node = game:GetService(root.service)
	for index = 2, #root.path do
		node = node:FindFirstChild(root.path[index])
	end
	local package = node:FindFirstChild("MushroomLobby")
	assert(package, "MushroomLobby missing under " .. table.concat(root.path, "."))
	walk(package, root.path)
end

local HEADER = [[
-- GENERATED by tools/make_installer.luau. Run the chunks in order in the
-- Studio command bar of the LOBBY place (edit mode). Chunk %d of %d.
if game.PlaceId ~= 106448766989936 then
	error("This is not the Lobby place. Nothing was changed.")
end
local function locate(path)
	local node = game:GetService(path[1])
	for index = 2, #path - 1 do
		node = node:FindFirstChild(path[index])
		if not node then
			error("missing parent " .. table.concat(path, ".", 1, index))
		end
	end
	return node
end
local function put(path, className, source)
	local parent = locate(path)
	local name = path[#path]
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName ~= className then
		existing:Destroy()
		existing = nil
	end
	local instance = existing or Instance.new(className)
	instance.Name = name
	if source then
		instance.Source = source
	end
	instance.Parent = parent
end
]]

local RESET = [[
-- Remove the previous copy of the package so deleted modules do not linger.
for _, path in {
	{ "ReplicatedStorage", "MushroomLobby" },
	{ "ServerScriptService", "MushroomLobby" },
	{ "StarterPlayer", "StarterPlayerScripts", "MushroomLobby" },
} do
	local parent = locate(path)
	local old = parent:FindFirstChild("MushroomLobby")
	if old then
		old:Destroy()
	end
end
]]

local chunks = { {} }
local size = 0
for _, entry in entries do
	local pathLiteral = '{ "' .. table.concat(entry.path, '", "') .. '" }'
	local line = `put({pathLiteral}, "{entry.className}", {if entry.source then literal(entry.source) else "nil"})\n`
	if size > 0 and size + #line > CHUNK_BYTES then
		table.insert(chunks, {})
		size = 0
	end
	table.insert(chunks[#chunks], line)
	size += #line
end

if fs.isDir(OUT) then
	fs.removeDir(OUT)
end
fs.writeDir(OUT)
for index, lines in chunks do
	local body = string.format(HEADER, index, #chunks)
	if index == 1 then
		body ..= RESET
	end
	body ..= table.concat(lines)
	body ..= `print("[MushroomLobby] installed chunk {index} of {#chunks}")\n`
	local path = string.format("%s/%02d_install.luau", OUT, index)
	fs.writeFile(path, body)
	print(`wrote {path} ({#body} bytes)`)
end
print(`{#entries} instances in {#chunks} chunk(s)`)
